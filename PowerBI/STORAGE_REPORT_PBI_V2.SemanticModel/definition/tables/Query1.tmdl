table Query1
	lineageTag: d8812696-382a-4939-a429-27b133e05874

	measure 'Earliest LAST_DDL max per Day' =
			
			MAXX(
				KEEPFILTERS(VALUES('Query1'[LAST_DDL].[Day])),
				CALCULATE(MIN('Query1'[LAST_DDL]))
			)
		formatString: General Date
		lineageTag: d0694195-7501-4172-9ef9-c251572b2afa

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MaxPerCategory"
				}

		changedProperty = FormatString

	measure 'Earliest LAST_DDL max per LAST_DDL' =
			
			MAXX(
				KEEPFILTERS(VALUES('Query1'[LAST_DDL])),
				CALCULATE(MIN('Query1'[LAST_DDL]))
			)
		formatString: General Date
		lineageTag: bd5f5fa5-ac2e-4f4e-b490-0c486c9cde02

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MaxPerCategory"
				}

		changedProperty = FormatString

	measure 'Earliest LAST_DDL min per LAST_DDL' =
			
			MINX(
				KEEPFILTERS(VALUES('Query1'[LAST_DDL])),
				CALCULATE(MIN('Query1'[LAST_DDL]))
			)
		formatString: General Date
		lineageTag: 58afc022-0f4c-4e6d-a05c-85956b0d492b

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MinPerCategory"
				}

		changedProperty = FormatString

	measure Oldest_DDL =
			
			VAR DaysDiff = DATEDIFF(MIN('Query1'[LAST_DDL]), TODAY(), DAY)
			RETURN DaysDiff & " days"
		lineageTag: 8462bfbb-5a42-4e76-8ee5-65d3ea338f10

