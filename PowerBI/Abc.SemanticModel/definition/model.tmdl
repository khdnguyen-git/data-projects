model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["KN_PBI_COCO_USAGE","KN_PBI_USER_LIST","KN_PBI_QUERY_ACTIVITY"]

annotation PBI_ProTooling = ["DevMode"]

ref table KN_PBI_COCO_USAGE
ref table KN_PBI_USER_LIST
ref table KN_PBI_QUERY_ACTIVITY

ref cultureInfo en-US

