	partition KN_PBI_QUERY_ACTIVITY = m
		mode: directQuery
		source =
				let
				    Source = Snowflake.Databases("uhg-uhgdwaas.snowflakecomputing.com","VING_PRD_MNR_HCE_DATAINFRA_WH",[Implementation="2.0"]),
				    VING_PRD_TREND_DB_Database = Source{[Name="VING_PRD_TREND_DB",Kind="Database"]}[Data],
				    TMP_1M_Schema = VING_PRD_TREND_DB_Database{[Name="TMP_1M",Kind="Schema"]}[Data],
				    KN_PBI_QUERY_ACTIVITY_Table = TMP_1M_Schema{[Name="KN_PBI_QUERY_ACTIVITY",Kind="Table"]}[Data]
				in
